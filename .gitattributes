# Keep LF in the repository; Plugin Check rejects mixed line endings (Internal.LineEndings.Mixed).
* text=auto eol=lf
*.png binary

# Keep development files out of GitHub's "Download ZIP" / release archives.
/.github        export-ignore
/bin            export-ignore
/tests          export-ignore
/tools          export-ignore
/composer.json  export-ignore
/composer.lock  export-ignore
/package.json   export-ignore
/phpunit.xml    export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
